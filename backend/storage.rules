rules_version = '2';

// Profile photos: anyone signed in may view one (the app only shows them to people in your
// circle); only you may set or remove yours. Small images only.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
          || (request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
