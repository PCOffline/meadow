{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/lib",
			"!**/coverage",
			"!hosting"
		]
	},
	"formatter": { "enabled": false },
	"linter": {
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	}
}
