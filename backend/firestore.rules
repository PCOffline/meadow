rules_version = '2';

// Everything that changes who looks after whom, or that loosens a commitment, goes through
// Cloud Functions (which bypass these rules). Phones may only make things stricter.
//
// Who looks after whom lives in users/{uid}/private/account, readable only by its owner:
// managing your Bumblebees is your own business. Rules still read it via get().
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function account(uid) { return get(/databases/$(database)/documents/users/$(uid)/private/account).data; }
    function isApproverOf(uid) { return me() in account(uid).approverIds; }
    function isApproveeOf(uid) { return me() in account(uid).approveeIds; }
    function hasNoApprovers(uid) { return account(uid).approverIds.size() == 0; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isString(v, max) { return v is string && v.size() <= max; }

    function validLimit(d, pkg) {
      return d.packageName == pkg
        && isString(d.appName, 100)
        && d.dailyMinutes is int && d.dailyMinutes >= 0 && d.dailyMinutes <= 1440
        && d.weeklyMinutes is int && d.weeklyMinutes >= 0 && d.weeklyMinutes <= 10080
        && (d.dailyMinutes > 0 || d.weeklyMinutes > 0);
    }

    // 0 means "no limit" for that period, so going from 0 to anything is stricter.
    function isStricter(old, next) {
      return (old.dailyMinutes == 0 || (next.dailyMinutes > 0 && next.dailyMinutes <= old.dailyMinutes))
        && (old.weeklyMinutes == 0 || (next.weeklyMinutes > 0 && next.weeklyMinutes <= old.weeklyMinutes));
    }

    function validProfileEdit(d) {
      return (!('displayName' in changed()) || (d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 30))
        && (!('flower' in changed()) || isString(d.flower, 16))
        && (!('avatarColor' in changed()) || isString(d.avatarColor, 20))
        && (!('photoUrl' in changed()) || d.photoUrl == null || isString(d.photoUrl, 1000))
        && (!('bio' in changed()) || isString(d.bio, 80))
        && (!('privacy' in changed()) || (d.privacy.keys().hasOnly(['shareUsage', 'shareProtection'])
              && d.privacy.shareUsage is bool && d.privacy.shareProtection is bool));
    }

    match /users/{uid} {
      // You, your Bumblebees, and the people you look after.
      allow read: if signedIn() && (me() == uid || isApproverOf(uid) || isApproveeOf(uid));
      allow create, delete: if false;
      allow update: if signedIn() && me() == uid
        && changed().hasOnly(['displayName', 'flower', 'avatarColor', 'photoUrl', 'bio', 'privacy',
                              'lastHeartbeat', 'protection', 'strictMode', 'emergencyUntil'])
        && validProfileEdit(request.resource.data)
        // Strict mode can always be switched on, but only switched off without Bumblebees.
        && (!('strictMode' in changed()) || request.resource.data.strictMode == true || hasNoApprovers(uid))
        // An emergency unlock can only be ended early from the phone, never started or extended.
        && (!('emergencyUntil' in changed()) || request.resource.data.emergencyUntil <= request.time);

      match /private/{docId} {
        allow read: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid && docId == 'account'
          && changed().hasOnly(['fcmTokens', 'theme', 'darkMode', 'acceptedTerms'])
          && (!('acceptedTerms' in changed())
              || (request.resource.data.acceptedTerms.keys().hasOnly(['version', 'at'])
                  && request.resource.data.acceptedTerms.version is int
                  && request.resource.data.acceptedTerms.at == request.time))
          && (!('fcmTokens' in changed()) || request.resource.data.fcmTokens.size() <= 10)
          && (!('theme' in changed()) || isString(request.resource.data.theme, 20))
          && (!('darkMode' in changed()) || isString(request.resource.data.darkMode, 10));
        allow create, delete: if false;
      }

      match /limits/{pkg} {
        allow read: if signedIn() && (me() == uid || isApproverOf(uid));
        allow create: if signedIn() && me() == uid && validLimit(request.resource.data, pkg);
        allow update: if signedIn() && me() == uid && validLimit(request.resource.data, pkg)
          && (hasNoApprovers(uid) || isStricter(resource.data, request.resource.data));
        allow delete: if signedIn() && me() == uid && hasNoApprovers(uid);
      }

      match /grants/{grantId} {
        allow read: if signedIn() && (me() == uid || isApproverOf(uid));
        allow write: if false;
      }

      // Daily usage is shared with Bumblebees only while the owner allows it.
      match /usage/{day} {
        allow read: if signedIn() && (me() == uid
          || (isApproverOf(uid) && profile(uid).get('privacy', {}).get('shareUsage', true) == true));
        allow write: if signedIn() && me() == uid;
      }

      match /emergencies/{emergencyId} {
        allow read: if signedIn() && (me() == uid || isApproverOf(uid));
        allow write: if false;
      }

      match /alerts/{alertId} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['kind', 'lost', 'createdAt'])
          && request.resource.data.kind == 'protection_off'
          && request.resource.data.lost is list && request.resource.data.lost.size() <= 5;
        allow read, update, delete: if false;
      }
    }

    match /friendCodes/{code} {
      allow read, write: if false;
    }

    // Invite links are created, previewed and redeemed only through Cloud Functions.
    match /inviteLinks/{token} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.fromUid == me() || resource.data.toUid == me());
      allow write: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.requesterId == me() || me() in resource.data.approverIds);
      allow write: if false;
    }

    match /chats/{chatId} {
      function participant() {
        return signedIn() && me() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow read: if signedIn() && me() in resource.data.participants;
      allow create, delete: if false;
      allow update: if signedIn() && me() in resource.data.participants
        && changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastRead'])
        && (!('lastSenderId' in changed()) || request.resource.data.lastSenderId == me());

      match /messages/{messageId} {
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.kind == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Emulator-only record of pushes, read by integration tests through the admin SDK.
    match /_testOutbox/{id} {
      allow read, write: if false;
    }
  }
}
