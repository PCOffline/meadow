rules_version = '2';

// Everything that changes who looks after whom, or that loosens a commitment, goes through
// Cloud Functions (which bypass these rules). Phones may only make things stricter.
//
// The public profile is only a name card (name, flower, colour, photo, bio), readable by the
// person, their Bumblebees and the people they look after. Everything else about a person
// (who looks after them, strict mode, emergency state, settings) lives in
// users/{uid}/private/account, readable only by its owner. Rules still read it via get().
// Nobody ever learns who else looks after the same person.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function account(uid) { return get(/databases/$(database)/documents/users/$(uid)/private/account).data; }
    function isApproverOf(uid) { return me() in account(uid).approverIds; }
    function isApproveeOf(uid) { return me() in account(uid).approveeIds; }
    function hasNoApprovers(uid) { return account(uid).approverIds.size() == 0; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Whether the owner shares [part] ("shareLimits", "shareTime", "shareApps", "shareProgress")
    // with their Bumblebees. Nothing is shared until it's chosen.
    function shares(uid, part) {
      return account(uid).get('privacy', {}).get(part, false) == true;
    }

    function validPrivacy(p) {
      return p is map && p.keys().hasOnly(['shareLimits', 'shareTime', 'shareApps', 'shareProgress'])
        && (!('shareLimits' in p) || p.shareLimits is bool)
        && (!('shareTime' in p) || p.shareTime is bool)
        && (!('shareApps' in p) || p.shareApps is bool)
        && (!('shareProgress' in p) || p.shareProgress is bool);
    }
    function isString(v, max) { return v is string && v.size() <= max; }

    function validLimit(d, pkg) {
      return d.keys().hasOnly(['packageName', 'appName', 'dailyMinutes', 'weeklyMinutes', 'schedule', 'dayMinutes', 'caps', 'createdAt', 'updatedAt'])
        && d.packageName == pkg
        && isString(d.appName, 100)
        && d.dailyMinutes is int && d.dailyMinutes >= 0 && d.dailyMinutes <= 1440
        && d.weeklyMinutes is int && d.weeklyMinutes >= 0 && d.weeklyMinutes <= 10080
        && (!('schedule' in d) || d.schedule == null || validSchedule(d.schedule))
        && (!('dayMinutes' in d) || d.dayMinutes == null || (d.dayMinutes is map && d.dayMinutes.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7'])))
        && (!('caps' in d) || d.caps == null || (d.caps is list && d.caps.size() <= 6))
        && (d.dailyMinutes > 0 || d.weeklyMinutes > 0 || d.get('schedule', null) != null
            || d.get('dayMinutes', null) != null || d.get('caps', null) != null);
    }

    // Allowed hours per weekday ("1" = Monday). The windows themselves are checked when they
    // matter: phones enforce them, and the backend compares them before tightening.
    function validSchedule(s) {
      return s is map && s.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7']);
    }

    // Hours, days with their own limit and caps within hours: what rules can't compare.
    function sameSchedule(old, next) {
      return old.get('schedule', null) == next.get('schedule', null)
        && old.get('dayMinutes', null) == next.get('dayMinutes', null)
        && old.get('caps', null) == next.get('caps', null);
    }

    // 0 means "no limit" for that period, so going from 0 to anything is stricter.
    function isStricter(old, next) {
      return (old.dailyMinutes == 0 || (next.dailyMinutes > 0 && next.dailyMinutes <= old.dailyMinutes))
        && (old.weeklyMinutes == 0 || (next.weeklyMinutes > 0 && next.weeklyMinutes <= old.weeklyMinutes));
    }

    // A photo is only ever your own upload in Meadow's Storage (or the emulators'). A link to
    // anywhere else, another project's bucket included, would tell that server whenever someone
    // in your circle saw it. The sign-in token's audience is this project's ID, which names its
    // default bucket (older projects' end in appspot.com).
    function ownPhoto(url) {
      let bucket = request.auth.token.aud + '[.](firebasestorage[.]app|appspot[.]com)';
      return isString(url, 1000) && url.matches(
        '(https://firebasestorage[.]googleapis[.]com|http://(10[.]0[.]2[.]2|127[.]0[.]0[.]1|localhost):9199)'
        + '/v0/b/' + bucket + '/o/avatars%2F' + me() + '[?]alt=media(&token=[a-f0-9-]+)?(#v=[0-9]+)?');
    }

    function validProfileEdit(d) {
      return (!('displayName' in changed()) || (d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 30))
        && (!('flower' in changed()) || isString(d.flower, 16))
        && (!('avatarColor' in changed()) || isString(d.avatarColor, 20))
        && (!('photoUrl' in changed()) || d.photoUrl == null || ownPhoto(d.photoUrl))
        && (!('bio' in changed()) || isString(d.bio, 80));
    }

    match /users/{uid} {
      // The name card: you, your Bumblebees, and the people you look after.
      allow read: if signedIn() && (me() == uid || isApproverOf(uid) || isApproveeOf(uid));
      allow create, delete: if false;
      allow update: if signedIn() && me() == uid
        && changed().hasOnly(['displayName', 'flower', 'avatarColor', 'photoUrl', 'bio'])
        && validProfileEdit(request.resource.data);

      // Owner-only. Strict mode is the person's own business: on and off without asking anyone.
      match /private/{docId} {
        allow read: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid && docId == 'account'
          && changed().hasOnly(['pushIds', 'theme', 'darkMode', 'acceptedTerms', 'strictMode', 'privacy', 'emergencyUntil'])
          && (!('acceptedTerms' in changed())
              || (request.resource.data.acceptedTerms.keys().hasOnly(['version', 'at'])
                  && request.resource.data.acceptedTerms.version is int
                  && request.resource.data.acceptedTerms.at == request.time))
          && (!('pushIds' in changed()) || request.resource.data.pushIds.size() <= 10)
          && (!('theme' in changed()) || isString(request.resource.data.theme, 20))
          && (!('darkMode' in changed()) || isString(request.resource.data.darkMode, 10))
          && (!('strictMode' in changed()) || request.resource.data.strictMode is bool)
          && (!('privacy' in changed()) || validPrivacy(request.resource.data.privacy))
          // An emergency unlock can only be ended early from the phone, never started or extended.
          && (!('emergencyUntil' in changed()) || request.resource.data.emergencyUntil <= request.time);
        allow create, delete: if false;
      }

      // A Bumblebee's own copies of the requests sent to them. Only the backend writes them.
      match /inbox/{requestId} {
        allow read: if signedIn() && me() == uid;
        allow write: if false;
      }

      match /limits/{pkg} {
        allow read: if signedIn() && (me() == uid || (isApproverOf(uid) && shares(uid, 'shareLimits')));
        allow create: if signedIn() && me() == uid && validLimit(request.resource.data, pkg);
        // Allowed hours, days' own limits and caps can't be compared here, so with Bumblebees
        // they change through the backend's saveLimit, which checks they only got stricter. The app's name stays as it
        // was: Bumblebees read it in requests, and a new one could pass one app off as another.
        allow update: if signedIn() && me() == uid && validLimit(request.resource.data, pkg)
          && (hasNoApprovers(uid)
              || (isStricter(resource.data, request.resource.data) && sameSchedule(resource.data, request.resource.data)
                  && request.resource.data.appName == resource.data.appName));
        allow delete: if signedIn() && me() == uid && hasNoApprovers(uid);
      }

      // Owner-only: a grant names the Bumblebee who gave it.
      match /grants/{grantId} {
        allow read: if signedIn() && me() == uid;
        allow write: if false;
      }

      // What the owner shares with their Bumblebees, each part in a document of its own so these
      // rules can hold each choice: today's total (usage), today's top apps (appUsage) and how
      // the weeks compare (progress). Each holds only its part, and only the latest copy: one
      // document, "today", that says which day it is. Earlier days never leave the phone.
      match /usage/{docId} {
        allow read: if signedIn() && (me() == uid || (isApproverOf(uid) && shares(uid, 'shareTime')));
        allow create, update: if signedIn() && me() == uid && docId == 'today'
          && request.resource.data.keys().hasOnly(['dayKey', 'totalMinutes', 'updatedAt'])
          && isString(request.resource.data.dayKey, 10)
          && request.resource.data.totalMinutes is int && request.resource.data.totalMinutes >= 0 && request.resource.data.totalMinutes <= 1440;
        allow delete: if signedIn() && me() == uid;
      }

      match /appUsage/{docId} {
        allow read: if signedIn() && (me() == uid || (isApproverOf(uid) && shares(uid, 'shareApps')));
        allow create, update: if signedIn() && me() == uid && docId == 'today'
          && request.resource.data.keys().hasOnly(['dayKey', 'apps', 'updatedAt'])
          && isString(request.resource.data.dayKey, 10)
          && request.resource.data.apps is list && request.resource.data.apps.size() <= 15;
        allow delete: if signedIn() && me() == uid;
      }

      match /progress/{docId} {
        allow read: if signedIn() && (me() == uid || (isApproverOf(uid) && shares(uid, 'shareProgress')));
        allow create, update: if signedIn() && me() == uid && docId == 'current'
          && request.resource.data.keys().hasOnly(['weekChange', 'calmerWeeks', 'keptDays', 'limitDays', 'updatedAt'])
          && (request.resource.data.weekChange == null || request.resource.data.weekChange is int)
          && request.resource.data.calmerWeeks is int
          && request.resource.data.keptDays is int
          && request.resource.data.limitDays is int;
        allow delete: if signedIn() && me() == uid;
      }

      match /emergencies/{emergencyId} {
        allow read: if signedIn() && (me() == uid || isApproverOf(uid));
        allow write: if false;
      }

      // "Meadow may not be protecting me": no detail about which setting changed. The backend
      // tells Bumblebees at most once every two minutes (lastAlertAt), so alerts sooner than
      // that are refused here rather than each waking a function.
      match /alerts/{alertId} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['kind', 'createdAt'])
          && request.resource.data.kind == 'protection_off'
          && request.resource.data.createdAt == request.time
          && request.time > account(uid).get('lastAlertAt', timestamp.value(0)) + duration.value(2, 'm');
        allow read, update, delete: if false;
      }
    }

    match /friendCodes/{code} {
      allow read, write: if false;
    }

    // When each phone last checked in. Phones only move their own clock forward to "now"; the
    // backend alone reads it and decides when a quiet phone is worth a vague alert.
    match /heartbeats/{uid} {
      allow read, delete: if false;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'staleNotified'])
        && request.resource.data.at == request.time
        && request.resource.data.staleNotified == false;
      allow update: if signedIn() && me() == uid
        && changed().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    match /removals/{id} {
      allow read, write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // Invite links are created, previewed and redeemed only through Cloud Functions.
    match /inviteLinks/{token} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.fromUid == me() || resource.data.toUid == me());
      allow write: if false;
    }

    // Only the asker reads a request (it lists every Bumblebee asked); Bumblebees read their
    // own inbox copy instead.
    match /requests/{requestId} {
      allow read: if signedIn() && resource.data.requesterId == me();
      allow write: if false;
    }

    // A chat opens when someone becomes a Bumblebee. When the two part ways (and don't still
    // look after each other the other way round), the backend closes it: it keeps their old
    // messages, readable by the two of them, but loses their names and pictures, and nobody
    // can write in it until they join up again. It's deleted with either person's account.
    match /chats/{chatId} {
      function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
      function participant() { return signedIn() && me() in chat().participants; }
      function isOpen() { return !chat().get('closed', false); }

      allow read: if signedIn() && me() in resource.data.participants;
      allow create, delete: if false;
      // Each person updates only their own side of an open chat: the summary of a message they
      // just sent, and when they last read the chat.
      allow update: if signedIn() && me() in resource.data.participants
        && !resource.data.get('closed', false)
        && changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastRead'])
        && (!changed().hasAny(['lastMessage', 'lastMessageAt', 'lastSenderId'])
            || (request.resource.data.lastSenderId == me()
                && request.resource.data.lastMessageAt == request.time
                && isString(request.resource.data.lastMessage, 140)))
        && (!('lastRead' in changed())
            || request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([me()]));

      match /messages/{messageId} {
        allow read: if participant();
        function textMessage() {
          return request.resource.data.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt'])
            && request.resource.data.kind == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
        }
        // A photo or GIF the sender uploaded to this chat's own folder in Storage.
        function imageMessage() {
          return request.resource.data.keys().hasOnly(['senderId', 'kind', 'createdAt', 'path', 'width', 'height', 'gif'])
            && request.resource.data.kind == 'image'
            && request.resource.data.path is string
            && request.resource.data.path.matches('chats/' + chatId + '/' + me() + '/[A-Za-z0-9_-]{8,64}[.](jpg|gif)')
            && request.resource.data.width is int && request.resource.data.width > 0 && request.resource.data.width <= 8192
            && request.resource.data.height is int && request.resource.data.height > 0 && request.resource.data.height <= 8192
            && request.resource.data.gif is bool;
        }
        allow create: if participant() && isOpen()
          && request.resource.data.senderId == me()
          && request.resource.data.createdAt == request.time
          && (textMessage() || imageMessage());
        allow update, delete: if false;
      }
    }

    // Emulator-only record of pushes, read by integration tests through the admin SDK.
    match /_testOutbox/{id} {
      allow read, write: if false;
    }
  }
}
