{
  "name": "meadow-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-include=lib/copy.js --test-coverage-include=lib/format.js --test-coverage-include=lib/schedule.js --test-coverage-include=lib/schemas.js --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=95 \"lib/**/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
