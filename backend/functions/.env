# Where Meadow's Cloud Functions run. This is the only place to set it: the backend, the app's
# build, the emulators and CI all read it from here. Pick the region closest to your Firestore
# database, e.g. europe-west1 for eur3 or us-central1 for nam5. After changing it, deploy the
# functions again and build a new app.
MEADOW_REGION=europe-west1
