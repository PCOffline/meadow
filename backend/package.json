{
  "name": "meadow-backend",
  "private": true,
  "scripts": {
    "emulators": "node emulators.mjs",
    "seed": "node emulator-seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-meadow \"node --test --test-concurrency=1 rules-tests/*.test.mjs\"",
    "test:integration": "node build-functions.cjs && c8 --check-coverage --lines 95 --functions 95 --branches 80 --reporter=text --reporter=lcov --report-dir=coverage --all --src=functions/src --include=functions/lib/** --exclude=functions/lib/**/*.test.js node emulators-exec.cjs --only auth,firestore,functions,storage --project demo-meadow \"node --test --test-concurrency=1 integration-tests/*.test.mjs\"",
    "test:hosting": "node --test hosting-tests/*.test.mjs",
    "test:deploy": "node --test deploy-tests/*.test.mjs",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@firebase/rules-unit-testing": "^6.0.0",
    "c8": "^12.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0",
    "google-auth-library": "^11.3.4",
    "jsdom": "^31.0.0",
    "marked": "^18.1.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "body-parser@^1.20.0": "^1.20.9",
    "body-parser@^2.0.0": "^2.4.0"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "re2": true
  }
}
