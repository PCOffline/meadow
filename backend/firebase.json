{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "**/*.test.*"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/i/**",
        "destination": "/invite.html"
      },
      {
        "source": "/privacy",
        "destination": "/legal.html"
      },
      {
        "source": "/terms",
        "destination": "/legal.html"
      },
      {
        "source": "/licenses",
        "destination": "/legal.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "predeploy": [
      "rm -rf \"$PROJECT_DIR/hosting/legal\" && cp -r \"$PROJECT_DIR/../legal\" \"$PROJECT_DIR/hosting/legal\""
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
